# Environment Configuration for Cloud File Share

# Flask Environment ('development', 'testing', or 'production')
FLASK_ENV=development

# Secret key for session encryption
SECRET_KEY=dev-secret-key-antigravity-change-me

# Storage Backend ('local' for development, 'gcs' for Google Cloud Storage)
STORAGE_BACKEND=local

# Google Cloud Storage Configuration (Required only when STORAGE_BACKEND=gcs)
GCS_BUCKET_NAME=your-google-cloud-storage-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Storage Quotas & Limits (Bytes)
# Default: 100 MB quota per user, 50 MB max per single file
USER_STORAGE_QUOTA=104857600
MAX_FILE_SIZE=52428800

# Server Port
PORT=5000
